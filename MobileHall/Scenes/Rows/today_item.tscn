[gd_scene format=3]

[ext_resource type="Script" path="res://MobileHall/Scripts/today_item.gd" id="1_today"]
[ext_resource type="Texture2D" path="res://MobileHall/Art/Textures/pin.png" id="2_pin"]

[node name="TodayItem" type="PanelContainer"]
size_flags_horizontal = 3
theme_type_variation = &"NoteCard"
script = ExtResource("1_today")

[node name="Col" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = -2

[node name="PinBox" type="CenterContainer" parent="Col"]
layout_mode = 2
mouse_filter = 2

[node name="Pin" type="TextureRect" parent="Col/PinBox"]
custom_minimum_size = Vector2(18, 18)
layout_mode = 2
mouse_filter = 2
texture = ExtResource("2_pin")
expand_mode = 1

[node name="Title" type="Label" parent="Col"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CapsLabel"
theme_override_font_sizes/font_size = 18
text = "Quests"
uppercase = true

[node name="Value" type="Label" parent="Col"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 36
text = "0 / 5"
