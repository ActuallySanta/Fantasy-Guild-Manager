[gd_scene format=3]

[ext_resource type="StyleBox" path="res://MobileHall/Styles/card.tres" id="1_card"]
[ext_resource type="Script" path="res://MobileHall/Scripts/home_section.gd" id="2_sec"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_tag"]
content_margin_left = 6.0
content_margin_top = 6.0
content_margin_right = 6.0
content_margin_bottom = 6.0
bg_color = Color(0.6, 0.27, 0.2, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[node name="HomeSection" type="PanelContainer"]
theme_override_styles/panel = ExtResource("1_card")
script = ExtResource("2_sec")

[node name="Col" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Top" type="HBoxContainer" parent="Col"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="TagBox" type="PanelContainer" parent="Col/Top"]
unique_name_in_owner = true
custom_minimum_size = Vector2(60, 44)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_tag")

[node name="Tag" type="Label" parent="Col/Top/TagBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 18
text = "TRN"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Names" type="VBoxContainer" parent="Col/Top"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="NameRow" type="HBoxContainer" parent="Col/Top/Names"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Name" type="Label" parent="Col/Top/Names/NameRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Training Yard"

[node name="Level" type="Label" parent="Col/Top/Names/NameRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 8
theme_override_colors/font_color = Color(0.4, 0.4, 0.4, 1)
theme_override_font_sizes/font_size = 20
text = "Lv 1"

[node name="Summary" type="Label" parent="Col/Top/Names"]
unique_name_in_owner = true
custom_minimum_size = Vector2(40, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "1 of 2 slots · +1 a night"
autowrap_mode = 3

[node name="List" type="VBoxContainer" parent="Col"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="Empty" type="Label" parent="Col"]
unique_name_in_owner = true
custom_minimum_size = Vector2(40, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.4, 0.4, 1)
theme_override_font_sizes/font_size = 20
text = "Nobody is training."
autowrap_mode = 3

[node name="AddButton" type="Button" parent="Col"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 76)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 24
text = "+ Add a hero"
