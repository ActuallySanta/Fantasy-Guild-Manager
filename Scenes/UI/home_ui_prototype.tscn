[node name="Log Contents" parent="MarginContainer/Intro Blurb/Background/VBoxContainer" parent_id_path=PackedInt32Array(2008083606, 1861553414) index="1" unique_id=2017656256]
text = "[font_size=45][color=black]Welcome to your new guild! You are a fledgling guild master with the goal of getting rich and defeating the demon king! To do so you must [b]HIRE[/b] guild members to [b]SEND[/b] on quests! You can choose to [b]ACCEPT[/b] or [b]DENY[/b] quests depending on what you want to prioritze. Your members will try to complete the quests to the best of their ability while trying to find [b]TREASURE[/b]. Your guild members can get [b]INJURED [/b]and will need to rest to heal back up. Try and do your best to claim your fortune and save the world![/font_size]"

